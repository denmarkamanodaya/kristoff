{
  "name": "kristoff-web",
  "version": "0.1.0",
  "private": true,
  "description": "Kristoff vanilla web client (static files, served by Amplify)",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs vendor",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs && node --test test/*.test.mjs",
    "test": "node --test test/*.test.mjs",
    "mock": "node scripts/mock-api.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.3"
  },
  "engines": {
    "node": ">=22"
  }
}
