node_modules/
.env
data/
# Terraform (backend/terraform): plans and data dirs never go in git; .terraform.lock.hcl files do.
*.tfplan
.terraform/
.terraform-*/
# The bootstrap root uses LOCAL state (owner-applied). Back it up outside git; see backend/terraform/README.md.
backend/terraform/bootstrap/*/terraform.tfstate
backend/terraform/bootstrap/*/terraform.tfstate.backup
# Kristoff Desktop (desktop/): build output, Tauri-generated schemas, and the local dev secrets
# (fake key + RFC 6238 test secret; release builds take the real values from the env).
desktop/target/
desktop/app/src-tauri/gen/
desktop/.env.local
# Law index data (desktop/data/): the dataset, model files and phlaws.db are built locally by
# desktop/scripts/fetch-*.sh and kristoff-ingest; only the two lock files are committed.
!desktop/data/
desktop/data/*
!desktop/data/dataset.lock
!desktop/data/model.lock
# Release DMGs and their SHA-256 files (desktop/scripts/build-dmg.sh).
desktop/dist/
