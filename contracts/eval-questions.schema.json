{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "kristoff/contracts/eval-questions.schema.json",
 "title": "Kristoff Desktop eval questions",
 "description": "Shape of contracts/fixtures/eval/questions.json (Phase 5 \u00a71).",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schemaVersion",
  "description",
  "dataset",
  "questions"
 ],
 "properties": {
  "schemaVersion": {
   "const": 1
  },
  "description": {
   "type": "string",
   "maxLength": 1000
  },
  "dataset": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "revision"
   ],
   "properties": {
    "name": {
     "type": "string",
     "maxLength": 200
    },
    "revision": {
     "type": "string",
     "pattern": "^[0-9a-f]{40}$"
    }
   }
  },
  "questions": {
   "type": "array",
   "minItems": 40,
   "maxItems": 40,
   "items": {
    "oneOf": [
     {
      "$ref": "#/$defs/lookup"
     },
     {
      "$ref": "#/$defs/concept"
     },
     {
      "$ref": "#/$defs/mixed"
     }
    ]
   }
  }
 },
 "$defs": {
  "target": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "identifier",
    "label"
   ],
   "properties": {
    "identifier": {
     "type": "string",
     "minLength": 1,
     "maxLength": 120,
     "description": "laws.identifier in phlaws.db, e.g. Republic Act No. 9262 or 1987 Constitution"
    },
    "label": {
     "type": "string",
     "minLength": 1,
     "maxLength": 120,
     "description": "chunks.label of the provision's first part"
    }
   }
  },
  "lookup": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "kind",
    "language",
    "question",
    "targets"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[LCM][0-9]{2}$"
    },
    "language": {
     "enum": [
      "en",
      "tl",
      "taglish"
     ]
    },
    "question": {
     "type": "string",
     "minLength": 10,
     "maxLength": 500
    },
    "note": {
     "type": "string",
     "minLength": 1,
     "maxLength": 300
    },
    "kind": {
     "const": "lookup"
    },
    "targets": {
     "type": "array",
     "minItems": 1,
     "maxItems": 1,
     "items": {
      "$ref": "#/$defs/target"
     }
    }
   }
  },
  "concept": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "kind",
    "language",
    "question",
    "targets"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[LCM][0-9]{2}$"
    },
    "language": {
     "enum": [
      "en",
      "tl",
      "taglish"
     ]
    },
    "question": {
     "type": "string",
     "minLength": 10,
     "maxLength": 500
    },
    "note": {
     "type": "string",
     "minLength": 1,
     "maxLength": 300
    },
    "kind": {
     "const": "concept"
    },
    "targets": {
     "type": "array",
     "minItems": 1,
     "maxItems": 6,
     "items": {
      "$ref": "#/$defs/target"
     }
    }
   }
  },
  "mixed": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "kind",
    "language",
    "question",
    "targets",
    "doc",
    "docExpect"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[LCM][0-9]{2}$"
    },
    "language": {
     "enum": [
      "en",
      "tl",
      "taglish"
     ]
    },
    "question": {
     "type": "string",
     "minLength": 10,
     "maxLength": 500
    },
    "note": {
     "type": "string",
     "minLength": 1,
     "maxLength": 300
    },
    "kind": {
     "const": "mixed"
    },
    "targets": {
     "type": "array",
     "minItems": 1,
     "maxItems": 6,
     "items": {
      "$ref": "#/$defs/target"
     }
    },
    "doc": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "file",
      "pages"
     ],
     "properties": {
      "file": {
       "type": "string",
       "pattern": "^docs/m[0-9]{2}-[a-z0-9-]+\\.txt$"
      },
      "pages": {
       "type": "integer",
       "minimum": 1,
       "maximum": 10
      }
     }
    },
    "docExpect": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "page",
      "mustMention"
     ],
     "properties": {
      "page": {
       "type": "integer",
       "minimum": 1,
       "maximum": 10
      },
      "mustMention": {
       "type": "array",
       "minItems": 1,
       "maxItems": 5,
       "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
       }
      }
     }
    }
   }
  }
 }
}
