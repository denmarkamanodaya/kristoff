{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kristoff",
  "version": "0.1.0",
  "identifier": "app.kristoff.desktop",
  "build": {
    "frontendDist": "../../../web/dist-desktop",
    "beforeDevCommand": "npm --prefix ../../web run build -- --target desktop",
    "beforeBuildCommand": "npm --prefix ../../web run build -- --target desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kristoff",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; frame-src kristoff:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "public.app-category.education",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "14.0"
    }
  }
}
