{
  "name": "kristoff-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Kristoff backend: TypeScript Lambdas (TOTP auth, docs, chats, streamed answers) in the dk-coding layout",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11.13.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:it": "vitest run --config vitest.it.config.ts",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "knip": "knip",
    "dry-gate": "node ../scripts/dk-coding/dry-gate.mjs --root .",
    "check:versions": "node ../scripts/dk-coding/check-versions.mjs --config check-versions.json",
    "check:zod-max": "node scripts/check-zod-max.mjs",
    "build": "node scripts/build.mjs",
    "check:all": "npm run -s format:check && npm run -s lint && npm run -s typecheck && npm run -s test:coverage && npm run -s depcruise && npm run -s knip && npm run -s dry-gate && npm run -s check:versions && npm run -s check:zod-max && npm run -s build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@aws-sdk/client-dynamodb": "3.1149.0",
    "@aws-sdk/client-lambda": "3.1149.0",
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/client-ssm": "3.1149.0",
    "@aws-sdk/lib-dynamodb": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "pdf-lib": "1.17.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.2.4",
    "globals": "17.13.0",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
