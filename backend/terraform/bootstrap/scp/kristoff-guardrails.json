{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NoLeave",
      "Effect": "Deny",
      "Action": "organizations:LeaveOrganization",
      "Resource": "*"
    },
    {
      "Sid": "NoRoot",
      "Effect": "Deny",
      "Action": "*",
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:root"
        }
      }
    },
    {
      "Sid": "NoIamUsersOrKeys",
      "Effect": "Deny",
      "Resource": "*",
      "Action": [
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "iam:CreateLoginProfile",
        "iam:DeleteAccountPasswordPolicy"
      ]
    },
    {
      "Sid": "NoTrailOrDetectorChanges",
      "Effect": "Deny",
      "Resource": "*",
      "Action": [
        "cloudtrail:StopLogging",
        "cloudtrail:DeleteTrail",
        "cloudtrail:UpdateTrail",
        "cloudtrail:PutEventSelectors",
        "guardduty:DeleteDetector",
        "guardduty:UpdateDetector",
        "guardduty:DisassociateFromAdministratorAccount"
      ]
    },
    {
      "Sid": "NoAccountBpaChange",
      "Effect": "Deny",
      "Action": "s3:PutAccountPublicAccessBlock",
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": "arn:aws:iam::*:role/aws-reserved/sso.amazonaws.com/*/AWSReservedSSO_KristoffAdmin_*"
        }
      }
    },
    {
      "Sid": "NoBedrockInvocationLogging",
      "Effect": "Deny",
      "Action": "bedrock:PutModelInvocationLoggingConfiguration",
      "Resource": "*"
    }
  ]
}
